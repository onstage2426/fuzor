// Mutants that cannot change a result, matched by their whole original line (an exact,
// escaped copy). Each was checked by hand: a comparison whose sides always have the same
// type, a flag only read with isset(), an estimate or a cheaper equivalent read. The
// ones in a statement of their own are marked in the source instead.
{
    "source": {
        "directories": [
            "src"
        ]
    },
    "testFramework": "phpunit",
    "logs": {
        "text": "infection.log",
        "summary": "infection-summary.log"
    },
    "mutators": {
        "@default": true,
        "Assignment": {
            "ignoreSourceCodeByRegex": [
                "\\$termDocs \\+\\= array_column\\(\\$group\\['words'\\], 'num_docs', 'id'\\);",
                "\\$removed \\+\\= isset\\(\\$c\\['values'\\]\\) && \\$c\\['exclude'\\] \\? \\$this\\-\\>conditionRowCount\\(\\$c\\) \\: 0;",
                "\\$pairCount \\+\\= count\\(\\$docTermIds\\);",
                "\\$estimate \\+\\= \\$bound;"
            ]
        },
        "DecrementInteger": {
            "ignoreSourceCodeByRegex": [
                "\\$purged \\= 0;",
                "\\$placeholders \\= implode\\(',', array_fill\\(0, count\\(\\$chunk\\), '\\(\\?,\\?\\)'\\)\\);",
                "\\$doc    \\= json_decode\\(\\(string\\) \\$data, true, 512, JSON_THROW_ON_ERROR\\);",
                "totalDocuments\\:  \\(int\\) \\(\\$indexInfo\\['total_documents'\\] \\?\\? 0\\),",
                "if \\(self\\:\\:isClassInGroup\\(0, \\$group\\)\\) \\{",
                "\\$removed   \\= 0;",
                "\\$removed \\+\\= isset\\(\\$c\\['values'\\]\\) && \\$c\\['exclude'\\] \\? \\$this\\-\\>conditionRowCount\\(\\$c\\) \\: 0;",
                "if \\(\\$this\\-\\>conditionRowCount\\(\\$probed\\[0\\]\\) \\* \\(1 \\- min\\(1, \\$removed / \\$documents\\)\\) \\> \\$cap\\) \\{",
                "\\$kept    \\= 0;",
                "\\$added   \\= 0;",
                "if \\(\\$hits \\!\\=\\= 0 \\|\\| \\$docs \\!\\=\\= 0\\) \\{",
                "\\$wordTypos \\= isset\\(\\$this\\-\\>typoExactWords\\(\\)\\[\\$keyword\\]\\) \\? 0 \\: \\$this\\-\\>typoBudget\\(\\$surface\\);",
                "\\$total    \\= \\(int\\) \\(\\$this\\-\\>getInfoValues\\(\\['total_documents'\\]\\)\\['total_documents'\\] \\?\\? 0\\);",
                "\\$estimate \\= 0;",
                "\\$indexRows \\= \\$upTo \\=\\=\\= null \\? \\$documents \\: min\\(\\$upTo \\+ 1, \\$documents\\);",
                "\\. implode\\(',', array_fill\\(0, count\\(\\$batch\\), '\\(\\?, \\?\\)'\\)\\)",
                "throw new QueryException\\(\"\\{\\$what\\} \\{\\$class\\} must have a constructor without required arguments\\.\", 0, \\$e\\);",
                "\\$documents \\= max\\(1, \\(int\\) \\(\\$this\\-\\>getInfoValues\\(\\['total_documents'\\]\\)\\['total_documents'\\] \\?\\? 0\\)\\);",
                "\\$documents \\= \\(int\\) \\(\\$this\\-\\>getInfoValues\\(\\['total_documents'\\]\\)\\['total_documents'\\] \\?\\? 0\\);"
            ]
        },
        "Division": {
            "ignoreSourceCodeByRegex": [
                "if \\(\\$this\\-\\>conditionRowCount\\(\\$probed\\[0\\]\\) \\* \\(1 \\- min\\(1, \\$removed / \\$documents\\)\\) \\> \\$cap\\) \\{"
            ]
        },
        "FalseValue": {
            "ignoreSourceCodeByRegex": [
                "\\$this\\-\\>hasDeleted      \\= false;",
                "\\$truncated \\= false;",
                "if \\(\\$this\\-\\>getWordlistByKeyword\\(\\$synonym, false, false\\) \\!\\=\\= \\[\\]\\) \\{",
                "'multiRow'   \\=\\> false,"
            ]
        },
        "Increment": {
            "ignoreSourceCodeByRegex": [
                "\\$added\\+\\+;"
            ]
        },
        "IncrementInteger": {
            "ignoreSourceCodeByRegex": [
                "\\$placeholders \\= implode\\(',', array_fill\\(0, count\\(\\$chunk\\), '\\(\\?,\\?\\)'\\)\\);",
                "\\$doc    \\= json_decode\\(\\(string\\) \\$data, true, 512, JSON_THROW_ON_ERROR\\);",
                "if \\(self\\:\\:isClassInGroup\\(0, \\$group\\)\\) \\{",
                "\\$removed \\+\\= isset\\(\\$c\\['values'\\]\\) && \\$c\\['exclude'\\] \\? \\$this\\-\\>conditionRowCount\\(\\$c\\) \\: 0;",
                "if \\(\\$this\\-\\>conditionRowCount\\(\\$probed\\[0\\]\\) \\* \\(1 \\- min\\(1, \\$removed / \\$documents\\)\\) \\> \\$cap\\) \\{",
                "\\$total    \\= \\(int\\) \\(\\$this\\-\\>getInfoValues\\(\\['total_documents'\\]\\)\\['total_documents'\\] \\?\\? 0\\);",
                "\\$indexRows \\= \\$upTo \\=\\=\\= null \\? \\$documents \\: min\\(\\$upTo \\+ 1, \\$documents\\);",
                "\\$stmt\\-\\>execute\\(\\[\\$range\\['keyId'\\], \\.\\.\\.\\$range\\['params'\\], \\.\\.\\.\\(\\$upTo \\=\\=\\= null \\? \\[\\] \\: \\[\\$upTo \\+ 1\\]\\)\\]\\);",
                "\\. implode\\(',', array_fill\\(0, count\\(\\$batch\\), '\\(\\?, \\?\\)'\\)\\)",
                "throw new QueryException\\(\"\\{\\$what\\} \\{\\$class\\} must have a constructor without required arguments\\.\", 0, \\$e\\);",
                "\\$documents \\= max\\(1, \\(int\\) \\(\\$this\\-\\>getInfoValues\\(\\['total_documents'\\]\\)\\['total_documents'\\] \\?\\? 0\\)\\);",
                "\\$documents \\= \\(int\\) \\(\\$this\\-\\>getInfoValues\\(\\['total_documents'\\]\\)\\['total_documents'\\] \\?\\? 0\\);"
            ]
        },
        "LogicalAnd": {
            "ignoreSourceCodeByRegex": [
                "if \\(isset\\(\\$oldLengths\\[\\$id\\]\\) && \\!isset\\(\\$kept\\[\\$id\\]\\)\\) \\{",
                "if \\(\\$key \\!\\=\\= 'id' && \\$value \\!\\=\\= null && \\!isset\\(\\$this\\-\\>facetFieldSet\\[\\$key\\]\\)\\) \\{",
                "if \\(\\!isset\\(\\$this\\-\\>surfaceWordCache\\[\\$word\\]\\) && \\!Tokenizer\\:\\:isNgramToken\\(\\$word\\)\\) \\{",
                "if \\(is_int\\(\\$value\\) \\|\\| is_float\\(\\$value\\) && is_finite\\(\\$value\\)\\) \\{"
            ]
        },
        "LogicalOrAllSubExprNegation": {
            "ignoreSourceCodeByRegex": [
                "if \\(\\!\\$this\\-\\>documentStoreEnabled \\|\\| \\$oldLengths \\=\\=\\= \\[\\]\\) \\{",
                "if \\(is_int\\(\\$value\\) \\|\\| is_float\\(\\$value\\) && is_finite\\(\\$value\\)\\) \\{"
            ]
        },
        "Minus": {
            "ignoreSourceCodeByRegex": [
                "if \\(\\$this\\-\\>conditionRowCount\\(\\$probed\\[0\\]\\) \\* \\(1 \\- min\\(1, \\$removed / \\$documents\\)\\) \\> \\$cap\\) \\{"
            ]
        },
        "Multiplication": {
            "ignoreSourceCodeByRegex": [
                "if \\(\\$this\\-\\>conditionRowCount\\(\\$probed\\[0\\]\\) \\* \\(1 \\- min\\(1, \\$removed / \\$documents\\)\\) \\> \\$cap\\) \\{",
                "if \\(\\$indexRows \\* \\$rows \\<\\= \\$documents \\* \\$values \\* self\\:\\:RANGE_COUNT_ROWS_PER_VALUE\\) \\{"
            ]
        },
        "NotIdenticalNotEqual": {
            "ignoreSourceCodeByRegex": [
                "if \\(\\$existing \\!\\=\\= \\[\\]\\) \\{",
                "if \\(\\$newLength \\!\\=\\= \\$oldLengths\\[\\$id\\]\\) \\{",
                "if \\(\\$existingIds \\!\\=\\= \\[\\]\\) \\{",
                "found\\:        \\$rows \\!\\=\\= \\[\\],",
                "\\$applied        \\= \\$negationTokens \\!\\=\\= \\[\\];",
                "\\$applied \\= \\$applied && \\$this\\-\\>lookupTermId\\(\\$token\\) \\!\\=\\= null;",
                "if \\(\\$synRows \\!\\=\\= \\[\\]\\) \\{",
                "if \\(\\$fid \\!\\=\\= null\\) \\{",
                "if \\(\\$fieldIdBoostMap \\!\\=\\= \\[\\]\\) \\{",
                "\\} elseif \\(\\$others \\!\\=\\= \\[\\]\\) \\{",
                "if \\(\\$this\\-\\>getWordlistByKeyword\\(\\$synonym, false, false\\) \\!\\=\\= \\[\\]\\) \\{",
                "if \\(\\$affectedTermIds \\!\\=\\= \\[\\]\\) \\{",
                "if \\(\\$newTerms \\!\\=\\= \\[\\]\\) \\{",
                "if \\(\\$diffed \\!\\=\\= \\[\\]\\) \\{",
                "if \\(\\$rewrite \\!\\=\\= \\[\\]\\) \\{",
                "if \\(\\$doclistInsert \\!\\=\\= \\[\\]\\) \\{",
                "if \\(\\$positionInsert \\!\\=\\= \\[\\]\\) \\{",
                "if \\(\\$hits \\!\\=\\= 0 \\|\\| \\$docs \\!\\=\\= 0\\) \\{",
                "if \\(\\$shrunk \\!\\=\\= \\[\\]\\) \\{",
                "if \\(\\$rows \\!\\=\\= \\[\\]\\) \\{",
                "if \\(\\$ids \\!\\=\\= \\[\\]\\) \\{",
                "if \\(\\$key \\!\\=\\= 'id' && \\$value \\!\\=\\= null && \\!isset\\(\\$this\\-\\>facetFieldSet\\[\\$key\\]\\)\\) \\{",
                "if \\(\\$part \\!\\=\\= ''\\) \\{",
                "if \\(\\$packed \\!\\=\\= null\\) \\{",
                "if \\(\\$filterable \\!\\=\\= \\[\\]\\) \\{",
                "if \\(\\$part \\!\\=\\= false\\) \\{",
                "if \\(\\$missing \\!\\=\\= \\[\\]\\) \\{",
                "if \\(\\$unknown \\!\\=\\= \\[\\]\\) \\{",
                "if \\(\\$fieldId \\!\\=\\= null\\) \\{",
                "\\} elseif \\(is_string\\(\\$v\\) && \\$v \\!\\=\\= ''\\) \\{",
                "if \\(count\\(\\$tokens\\) \\!\\=\\= 1\\) \\{"
            ]
        },
        "OneZeroFloat": {
            "ignoreSourceCodeByRegex": [
                "\\$weighted \\= \\$weightedHits\\[\\$termId\\]\\[\\$docId\\] \\?\\? 0\\.0;",
                "\\$idfK1p1val \\= \\$termIdfMap\\[\\$termId\\] \\?\\? 0\\.0;"
            ]
        },
        "Plus": {
            "ignoreSourceCodeByRegex": [
                "\\$whole \\= count\\(\\$deletes\\) \\+ count\\(\\$updates\\) \\+ \\$added \\> \\$kept;",
                "\\$indexRows \\= \\$upTo \\=\\=\\= null \\? \\$documents \\: min\\(\\$upTo \\+ 1, \\$documents\\);"
            ]
        },
        "PlusEqual": {
            "ignoreSourceCodeByRegex": [
                "\\$removed \\+\\= isset\\(\\$c\\['values'\\]\\) && \\$c\\['exclude'\\] \\? \\$this\\-\\>conditionRowCount\\(\\$c\\) \\: 0;",
                "\\$pairCount \\+\\= count\\(\\$docTermIds\\);",
                "\\$estimate \\+\\= \\$bound;"
            ]
        },
        "TrueValue": {
            "ignoreSourceCodeByRegex": [
                "\\$seen\\[\\$key\\] \\= true;",
                "\\$docContribTermIds\\[\\$docId\\]\\[\\$termId\\]  \\= true;",
                "'selection'  \\=\\> true,",
                "\\$insertedIds\\[\\$termIds\\[\\(string\\) \\$term\\]\\] \\= true;",
                "\\$this\\-\\>surfaceWordCache\\[\\$word\\]    \\= true;",
                "\\$valuesPerKey\\[\\$keyId\\]\\[\\$row\\['value'\\]\\] \\= true;",
                "\\$keyMap\\[\\$keyId\\]\\[self\\:\\:sortKey\\(\\(string\\) \\$value\\)\\]\\[\\$docId\\] \\= true;",
                "'compound'   \\=\\> true,",
                "\\$inverse\\[\\$id\\] \\= true;",
                "\\$withStrings\\[\\$keyId\\] \\= true;"
            ]
        }
    }
}
